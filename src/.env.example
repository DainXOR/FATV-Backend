# SMTP delivery (required for account setup, recovery, and form invitations)
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=fatv@example.org

# Public frontend URL used for shareable form links and account/invitation emails
FRONTEND_BASE_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000

# Set true only when the backend is served over HTTPS
SESSION_COOKIE_SECURE=false

# Optional one-time first-admin bootstrap; only runs if no platform accounts exist.
# With a password (16+ chars), creates an active admin without SMTP. Remove both values after startup.
# Without a password, the normal emailed setup-code flow is used and SMTP is required.
FATV_BOOTSTRAP_ADMIN_EMAIL=
FATV_BOOTSTRAP_ADMIN_PASSWORD=

# Development-only diagnostics. These are rejected when APP_ENV=prod.
# FATV_DEV_AUTH_BYPASS skips session/CSRF checks and uses an active admin identity.
# FATV_DEV_SHOW_ACTION_CODES skips SMTP, returns setup codes to admin actions,
# and enables the login-page setup-code lookup. Never enable either in production.
FATV_DEV_AUTH_BYPASS=false
FATV_DEV_SHOW_ACTION_CODES=false

# Required authentication pepper. Generate with: openssl rand -hex 64
# Keep it identical in name across dev/deploy, but use independent secret values per environment.
FATV_AUTH_PEPPER=
