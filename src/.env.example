# SMTP delivery (required for account setup, recovery, and form invitations)
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=fatv@example.org

# Public frontend URL used in emailed invitation links
FRONTEND_BASE_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000

# Set true only when the backend is served over HTTPS
SESSION_COOKIE_SECURE=false

# Optional one-time first-admin bootstrap; only runs if no platform accounts exist.
# With a password (16+ chars), creates an active admin without SMTP. Remove both values after startup.
# Without a password, the normal emailed setup-code flow is used and SMTP is required.
FATV_BOOTSTRAP_ADMIN_EMAIL=
FATV_BOOTSTRAP_ADMIN_PASSWORD=
